# ── Database ──────────────────────────
MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_DBNAME=UnifiedMessagingService_dev

# ── Auth ──────────────────────────────
NEXTAUTH_SECRET=<openssl rand -hex 32>
NEXTAUTH_URL=http://localhost:3110

# ── Encryption (AES-256-GCM, 32-byte hex) ──
ENCRYPTION_KEY=<openssl rand -hex 32>

# ── Unsubscribe token / webhook signing ──
UNSUBSCRIBE_SECRET=<openssl rand -hex 32>
WEBHOOK_SECRET=<openssl rand -hex 32>

# ── Dispatch ──────────────────────────
# 실제 발송은 DRY_RUN=false 를 명시한 경우에만 (미설정·그 외 값이면 시뮬레이션 — fail-safe)
DRY_RUN=true
DISPATCH_POLL_INTERVAL_MS=30000

# ── App ───────────────────────────────
NEXT_PUBLIC_APP_NAME=통합 메시징 서비스
NEXT_PUBLIC_BASE_URL=http://localhost:3110
